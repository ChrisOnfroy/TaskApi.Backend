<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <!-- Workaround para el apphost.exe corrupto del SDK local (NETSDK1029). Se ejecuta con dotnet run -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskApi.Application\TaskApi.Application.csproj" />
    <ProjectReference Include="..\TaskApi.Infrastructure\TaskApi.Infrastructure.csproj" />
  </ItemGroup>

</Project>
